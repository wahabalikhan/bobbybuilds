/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Secrets never go in this file. Use `npx wrangler secret put NAME` (see .dev.vars.example).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bobbybuilds",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the Worker name.
			// https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bobbybuilds"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bobbybuilds-db",
			"database_id": "e9b730ed-b736-4006-b5d8-8059494cb6b7",
			"migrations_dir": "migrations"
		}
	],
	// The public snapshot: everything the public pages show, rebuilt from the roll-ups every 10 minutes
	// and only written when it changes (at most ~144 writes a day; the free plan allows 1,000).
	"kv_namespaces": [{ "binding": "PUBLIC_CACHE", "id": "d905bda1b9a04f908918cd80b4cbeb64" }],
	// Collector rate limits, per minute. Keys are hashes (never raw IPs). Counters are per Cloudflare location.
	"ratelimits": [
		{ "name": "PV_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		{ "name": "EVENTS_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "METRICS_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
	],
	// The site lives at the bare domain only. Never add a wildcard route (*.bobbybuilds.app/*):
	// jobs. belongs to the job board and mail. to Resend (see "Domain plan" in CLAUDE.md).
	"routes": [{ "pattern": "bobbybuilds.app", "custom_domain": true }],
	// workers.dev stays on only until the portfolio and job board use bobbybuilds.app (docs/access-setup.md, Step 6).
	// Preview URLs stay off: they would be a second, unprotected way in.
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		// Not secret, but required: /admin refuses every request until both are set.
		// Both come from the Cloudflare Access application (see docs/access-setup.md).
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
